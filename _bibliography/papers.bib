@article{belal2026desatta,
  abbr        = {arXiv},
  bibtex_show = {true},
  category    = {tta},
  title       = {DESA-TTA: Dynamic EMA and Source Anchoring for Test-Time Adaptation},
  author      = {Belal, Atif and Hollard, Lilian and Pedersoli, Marco and Granger, Eric},
  journal     = {arXiv preprint arXiv:2609.01795},
  year        = {2026},
  abstract    = {Mean-teacher test-time adaptation is sensitive to a fixed EMA rate, and noisy pseudo-labels make the student drift. DESA-TTA picks a per-sample EMA coefficient from the teacher's uncertainty and pulls the student back toward its pretrained weights in proportion to its drift. It gives consistent gains across distribution shifts and two vision-language detectors, including +14.5 AP50 over zero-shot inference on VOC-C.},
  arxiv       = {2609.01795},
  pdf         = {https://arxiv.org/pdf/2609.01795},
  code        = {https://github.com/imatif17/DESA-TTA},
  selected    = {true}
}

@inproceedings{belal2026vlodtta,
  abbr        = {ECCV},
  bibtex_show = {true},
  category    = {tta},
  title       = {VLOD-TTA: Test-Time Adaptation of Vision-Language Object Detectors},
  author      = {Belal, Atif and Medeiros, Heitor R. and Pedersoli, Marco and Granger, Eric},
  booktitle   = {European Conference on Computer Vision (ECCV)},
  year        = {2026},
  abstract    = {Vision-language object detectors such as YOLO-World and Grounding DINO lose accuracy under distribution shift. VLOD-TTA adapts them at test time with an IoU-weighted entropy loss that favors spatially coherent box clusters, and with image-conditioned prompt selection. It outperforms standard test-time adaptation baselines and the prior state of the art across artistic, adverse driving, low-light and corruption shifts.},
  arxiv       = {2510.00458},
  pdf         = {https://arxiv.org/pdf/2510.00458},
  code        = {https://github.com/imatif17/VLOD-TTA},
  selected    = {true}
}

@inproceedings{medeiros2026wiseod,
  abbr        = {WACV},
  bibtex_show = {true},
  category    = {mm},
  title       = {WiSE-OD: Benchmarking Robustness in Infrared Object Detection},
  author      = {Medeiros, Heitor R. and Belal, Atif and Aminbeidokhti, Masih and Granger, Eric and Pedersoli, Marco},
  booktitle   = {IEEE/CVF Winter Conference on Applications of Computer Vision (WACV)},
  year        = {2026},
  abstract    = {Infrared detectors are fine-tuned from RGB-pretrained weights, which improves accuracy but hurts robustness to distribution shifts. WiSE-OD ensembles model weights (RGB zero-shot with IR fine-tuned, or zero-shot with linear-probed) to improve robustness across modalities and to synthetic and real-world corruptions, with no extra training or inference cost.},
  arxiv       = {2507.18925},
  pdf         = {https://arxiv.org/pdf/2507.18925}
}

@inproceedings{nehdi2026lowrank,
  abbr        = {WACV},
  bibtex_show = {true},
  category    = {da},
  title       = {Low-Rank Expert Merging for Multi-Source Domain Adaptation in Person Re-Identification},
  author      = {Nehdi, Taha Mustapha and Mrabah, Nairouz and Belal, Atif and Pedersoli, Marco and Granger, Eric},
  booktitle   = {IEEE/CVF Winter Conference on Applications of Computer Vision (WACV)},
  pages       = {1809--1819},
  year        = {2026},
  abstract    = {Multi-source domain adaptation for person re-identification usually needs domain-specific backbones or access to source data. SAGE-reID is source-free: it trains a small low-rank adapter per source domain and learns a lightweight gating network to merge them. It outperforms state-of-the-art methods on Market-1501, DukeMTMC-reID and MSMT17 at a lower computational cost.},
  arxiv       = {2508.06831},
  html        = {https://openaccess.thecvf.com/content/WACV2026/html/Nehdi_Low-Rank_Expert_Merging_for_Multi-Source_Domain_Adaptation_in_Person_Re-Identification_WACV_2026_paper.html}
}

@inproceedings{medeiros2025modprompt,
  abbr        = {ICCV},
  bibtex_show = {true},
  category    = {mm},
  title       = {Visual Modality Prompt for Adapting Vision-Language Object Detectors},
  author      = {Medeiros, Heitor R. and Belal, Atif and Muralidharan, Srikanth and Granger, Eric and Pedersoli, Marco},
  booktitle   = {IEEE/CVF International Conference on Computer Vision (ICCV)},
  pages       = {2172--2182},
  year        = {2025},
  abstract    = {Vision-language detectors such as YOLO-World and Grounding DINO struggle on new visual modalities like infrared and depth. ModPrompt is an encoder-decoder visual prompt with a decoupled residual that adapts them to these modalities without degrading their zero-shot ability. On LLVIP, FLIR and NYUv2, it approaches the performance of full fine-tuning.},
  arxiv       = {2412.00622},
  html        = {https://openaccess.thecvf.com/content/ICCV2025/html/Medeiros_Visual_Modality_Prompt_for_Adapting_Vision-Language_Object_Detectors_ICCV_2025_paper.html},
  code        = {https://github.com/heitorrapela/ModPrompt},
  selected    = {true}
}

@inproceedings{belal2025acia,
  abbr        = {WACV},
  bibtex_show = {true},
  category    = {da},
  title       = {Attention-Based Class-Conditioned Alignment for Multi-Source Domain Adaptation of Object Detectors},
  author      = {Belal, Atif and Meethal, Akhil and Romero, Francisco Perdigon and Pedersoli, Marco and Granger, Eric},
  booktitle   = {IEEE/CVF Winter Conference on Applications of Computer Vision (WACV)},
  pages       = {8555--8564},
  year        = {2025},
  abstract    = {Most multi-source domain adaptation methods for object detection align features without considering object classes, and prototype-based class-wise alignment suffers from noisy pseudo-labels and class imbalance. ACIA uses an attention module with an adversarial domain classifier to learn instance representations that are both domain-invariant and class-specific.},
  arxiv       = {2403.09918},
  pdf         = {https://openaccess.thecvf.com/content/WACV2025/papers/Belal_Attention-Based_Class-Conditioned_Alignment_for_Multi-Source_Domain_Adaptation_of_Object_Detectors_WACV_2025_paper.pdf},
  code        = {https://github.com/imatif17/ACIA},
  selected    = {true}
}

@inproceedings{belal2024pmt,
  abbr        = {WACV},
  bibtex_show = {true},
  category    = {da},
  title       = {Multi-Source Domain Adaptation for Object Detection with Prototype-based Mean Teacher},
  author      = {Belal, Atif and Meethal, Akhil and Romero, Francisco Perdigon and Pedersoli, Marco and Granger, Eric},
  booktitle   = {IEEE/CVF Winter Conference on Applications of Computer Vision (WACV)},
  pages       = {1277--1286},
  year        = {2024},
  abstract    = {Multi-source domain adaptation methods for object detection often add a domain-specific subnetwork for each source, so the number of parameters grows with the number of sources. PMT (Prototype-based Mean Teacher) replaces them with class prototypes learned with a contrastive loss, keeping the model compact, and outperforms state-of-the-art methods on several object detection benchmarks.},
  arxiv       = {2309.14950},
  pdf         = {https://openaccess.thecvf.com/content/WACV2024/papers/Belal_Multi-Source_Domain_Adaptation_for_Object_Detection_With_Prototype-Based_Mean_Teacher_WACV_2024_paper.pdf},
  code        = {https://github.com/imatif17/Prototype-Mean-Teacher},
  selected    = {true}
}

@inproceedings{nguyenmeidine2021mtda,
  abbr        = {WACV},
  bibtex_show = {true},
  category    = {da},
  title       = {Unsupervised Multi-Target Domain Adaptation Through Knowledge Distillation},
  author      = {Nguyen-Meidine, Le Thanh and Belal, Atif and Kiran, Madhu and Dolz, Jose and Blais-Morin, Louis-Antoine and Granger, Eric},
  booktitle   = {IEEE/CVF Winter Conference on Applications of Computer Vision (WACV)},
  pages       = {1339--1347},
  year        = {2021},
  abstract    = {Training one model per target domain is costly, and blending several targets into one can hurt accuracy on each. MT-MTDA distills knowledge from several target-specific teachers into one shared student, alternating between teachers to preserve each target's specificity. It achieves higher accuracy across multiple target domains than state-of-the-art methods on several domain adaptation benchmarks.},
  arxiv       = {2007.07077},
  pdf         = {https://openaccess.thecvf.com/content/WACV2021/papers/Le_Thanh_Nguyen-Meidine_Unsupervised_Multi-Target_Domain_Adaptation_Through_Knowledge_Distillation_WACV_2021_paper.pdf}
}

@article{nguyenmeidine2021ivc,
  abbr        = {IVC},
  bibtex_show = {true},
  category    = {da},
  title       = {Knowledge Distillation Methods for Efficient Unsupervised Adaptation Across Multiple Domains},
  author      = {Nguyen-Meidine, Le Thanh and Belal, Atif and Kiran, Madhu and Dolz, Jose and Blais-Morin, Louis-Antoine and Granger, Eric},
  journal     = {Image and Vision Computing},
  volume      = {108},
  pages       = {104096},
  year        = {2021},
  abstract    = {CNNs deployed in the real world must cope with domain shift and limited compute. This work proposes progressive knowledge distillation for single-target (KD-STDA) and multi-target (KD-MTDA) unsupervised domain adaptation, which adapts and compresses a CNN at the same time by distilling from a larger teacher. It achieves the highest target accuracy on Office31, ImageCLEF-DA, Digits and OfficeHome with CNNs of equal or lower complexity.},
  doi         = {10.1016/j.imavis.2021.104096},
  arxiv       = {2101.07308}
}
